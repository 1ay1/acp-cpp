#pragma once

namespace acp {

// Library semver. Reflects `project(... VERSION)` from CMakeLists.txt.
inline constexpr int         kLibraryVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int         kLibraryVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int         kLibraryVersionPatch = @PROJECT_VERSION_PATCH@;
inline constexpr const char* kLibraryVersion      = "@PROJECT_VERSION@";

// ACP wire protocol version (a single integer per the spec — bumped only on
// breaking changes). Set in CMakeLists.txt via the ACP_PROTOCOL_VERSION cache
